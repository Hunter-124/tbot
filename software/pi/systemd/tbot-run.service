# TBOT live pipeline as a service (installed by scripts/tbotctl install; NOT enabled at boot by default,
# because the calibration tools need the camera to themselves).
[Unit]
Description=TBOT pipeline (camera -> detect -> track -> fire solver)
# No After=multi-user.target: waiting for the rest of the boot (network and all) cost ~10 s of every power-up.
# The default dependencies (local filesystems, udev) are all the camera and the IMU need; a camera not yet
# probed is a failed start, retried 3 s later.
# never give up restarting (the default stops after 5 starts in 10 s)
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/TBOT/software
# All four cores at full clock while the pipeline runs (as root: the "+"; "-": a kernel without cpufreq is not
# a failed start). With ondemand the clock drops between frames and the next one starts at 600 MHz.
ExecStartPre=-+/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g"; done'
ExecStart=/home/pi/TBOT/software/scripts/tbot-run.sh
# Ahead of everything else on the Pi (the console, clip rendering, ssh): the frame loop and its sensor process.
Nice=-10
# Whatever ends it (a crash, the camera gone for good, a clean exit), it is started again; only
# `tbotctl stop` (systemctl stop) keeps it stopped.
Restart=always
RestartSec=3
# A frame loop that stops turning without exiting (a hang) is killed and restarted: the pipeline reports in
# every 2 s (app/run.py _sd_notify). Long enough for a cold start on a Pi 3B (imports ~12 s, camera, IMU).
WatchdogSec=60
NotifyAccess=all
# SIGTERM -> the pipeline aborts the actuator and goes limp before exiting. Only the main process gets it
# (mixed): the pipeline then stops its sensor process itself, in order; whatever is left after
# TimeoutStopSec is killed. (control-group sent it to every process at once, and the multiprocessing helper
# died before the pipeline had cleaned up.)
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=10
RuntimeDirectory=tbot
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
